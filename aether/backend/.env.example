# AI inference runs through a cloud API. Pick the active one with AETHER_PROVIDER
# (openai | groq | gemini) — each keeps its own key below, so switching back and forth
# never requires re-entering anything. Copy this file to ".env" and fill in a real key;
# never commit the real .env (it's gitignored).
AETHER_PROVIDER=groq

OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Leave AETHER_MODEL/AETHER_FAST_MODEL unset to use each provider's sensible default
# (see app/config.py _PROVIDERS), or override here to pin a specific model.
AETHER_WHISPER_MODEL=base
AETHER_OUTPUT_DIR=output
AETHER_ALLOWED_ORIGIN=http://localhost:5173
